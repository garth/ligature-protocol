<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Ligature Protocol user daemon: a launchd agent that runs ligatured from
  ~/Applications/Ligature.app at login, signed ad hoc and not notarised. The
  daemon runs from the bundle because macOS shows notifications only from a
  bundled process (LP-94). install.sh (from a release tarball or packaging/ in
  a checkout) makes the HOME paths absolute and loads it; README.md next to this file has the steps by hand. State lives
  in ~/Library/Application Support/ligature and the control socket in
  $TMPDIR/ligature, which lpctl finds without being told (LP-85). The UDP port
  is fixed so a firewall rule can let peers dial in.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>org.ligatureprotocol.ligatured</string>
  <key>ProgramArguments</key>
  <array>
    <string>HOME/Applications/Ligature.app/Contents/MacOS/ligatured</string>
  </array>
  <key>AssociatedBundleIdentifiers</key>
  <string>org.ligatureprotocol.ligatured</string>
  <key>EnvironmentVariables</key>
  <dict>
    <!-- launchd's own PATH holds only the system directories; ffmpeg, which
         screen sharing and viewing run, is usually Homebrew's (LP-150). -->
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>LIGATURE_PORT</key>
    <string>47471</string>
    <key>RUST_LOG</key>
    <string>info</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <!-- Interactive, as an application is scheduled: the input capture and the
       screen share run in real time, and Background's throttling held the
       share to about a dozen frames a second and the input round trip to a
       quarter of a second (LP-150). -->
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>StandardOutPath</key>
  <string>HOME/Library/Logs/ligature/ligatured.log</string>
  <key>StandardErrorPath</key>
  <string>HOME/Library/Logs/ligature/ligatured.log</string>
</dict>
</plist>
