<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- The multicast lock: without it the Wi-Fi driver drops mDNS. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Sharing the screen (milestone 8): the projection runs in a service
         of its own type, after the user consents each time. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- The phone's sound with a share of its screen (milestone 9): Android
         puts capturing what the phone plays behind the recording permission.
         Asked for only from the Cast card; the microphone is never opened. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- A dark screen gives a viewer no picture and takes no touch. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Since Android 14 a wake lock lights the screen only with this, which
         the user can take back under Special app access, Turn screen on. -->
    <uses-permission android:name="android.permission.TURN_SCREEN_ON" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Signature-level: granted only to a build signed with the platform key
         (a self-built LineageOS). With it, copies are sent automatically;
         without it, the tile, the notification action and sharing send them. -->
    <uses-permission
        android:name="android.permission.READ_CLIPBOARD_IN_BACKGROUND"
        tools:ignore="ProtectedPermissions" />

    <application
        android:name=".LigatureApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@drawable/ic_ligature"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ligature">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTask">
            <!-- Turning the phone keeps the activity: the watch screen's
                 decoder and drive go on across it (LP-173). -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Transparent and focused for an instant: that is when Android lets
             the app read the clipboard. Started by the tile, the notification
             action and the main screen. -->
        <activity
            android:name=".SendClipboardActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Ligature.Transparent" />

        <!-- "Send to my devices": text arrives in the intent and goes to every
             clipboard; files go to one device the user picks (milestone 4). -->
        <activity
            android:name=".ShareActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/share_target"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Ligature.Transparent">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- Opens the media projection dialog for a viewer's request and
             starts the share on consent (milestone 8). Not noHistory: the
             dialog's result comes back to it. -->
        <activity
            android:name=".ScreenConsentActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@style/Theme.Ligature.Transparent" />

        <service
            android:name=".ScreenShareService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- The Stop sharing action on the share's notification. -->
        <receiver
            android:name=".ScreenShare$StopReceiver"
            android:exported="false" />

        <!-- An offered cast's notification swiped away: the cast is declined. -->
        <receiver
            android:name=".CastOffers$DeclineReceiver"
            android:exported="false" />

        <!-- The cancel action on a transfer's progress notification. -->
        <receiver
            android:name=".Transfers$TransferReceiver"
            android:exported="false" />

        <!-- The Save action on the clipboard files notification (milestone 5). -->
        <receiver
            android:name=".NodeHolder$SaveClipboardReceiver"
            android:exported="false" />

        <!-- Serves the parts and files of a clipboard value a peer sent, as the
             content URIs on the clip; the system grants the pasting app access. -->
        <provider
            android:name=".ClipboardProvider"
            android:authorities="org.ligatureprotocol.android.clipboard"
            android:exported="false"
            android:grantUriPermissions="true" />

        <service
            android:name=".NodeService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- Notification access, granted by the user in Settings: what the
             phone's apps post goes to the other devices (milestone 3). -->
        <service
            android:name=".NotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Turned on by the user under Accessibility: another device drives
             this phone through its gestures and input connection (LP-167). -->
        <service
            android:name=".DriveService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/drive_service" />
        </service>

        <service
            android:name=".SendClipboardTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="false" />
        </service>

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
